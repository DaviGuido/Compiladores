funcao real media(real a, real b) {
  retorne (a + b) / 2.0;
}

funcao vazio principal() {
  inteiro i = 42;
  real r = 3.5;
  logico l = verdadeiro;
  texto t = "oi";
  escreva(i);
  escreva(r);
  escreva(l);
  escreva(t);
  escreva(media(1, 2));
  real convertido = i;
  escreva(convertido);
  inteiro semvalor;
  real semvalorr;
  logico semvalorl;
  texto semvalort;
  escreva(semvalor);
  escreva(semvalorr);
  escreva(semvalorl);
  escreva(semvalort);
}
