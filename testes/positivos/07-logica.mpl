funcao logico marcar(texto quem) {
  escreva(quem);
  retorne verdadeiro;
}

funcao vazio principal() {
  logico r = falso e marcar("direito avaliado");
  escreva(r);
  escreva(verdadeiro e verdadeiro);
  escreva(verdadeiro e falso);
  escreva(falso ou falso);
  escreva(nao falso);
  escreva(nao nao verdadeiro);
}
